# Copy to api/.env. Every value is optional; with an empty .env the API runs fully on mocks.

# --- LLM: any OpenAI-compatible Chat Completions endpoint ---
# OpenAI:  https://api.openai.com/v1
# Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
# Groq:    https://api.groq.com/openai/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Seconds per LLM call before falling back to the deterministic agent
LLM_TIMEOUT_S=4
# Seconds for a whole turn (several tool round trips)
LLM_TURN_BUDGET_S=10
# Optional: passed as reasoning_effort to keep reasoning models fast (e.g. low). Leave empty if unsure.
LLM_REASONING_EFFORT=

# --- ElevenLabs (speech-to-text token + text-to-speech proxy) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Low-latency TTS model
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Stripe: TEST keys only (sk_test_...). The server refuses to start with sk_live_. ---
STRIPE_SECRET_KEY=

# Dev only: lets the server sign carts for the browser before signing.ts is wired.
# Flagged in /health and the audit log. Keep false for the demo.
DEMO_SERVER_SIGNING=false

# Base URL used to build product image links
PUBLIC_BASE_URL=http://localhost:8000
