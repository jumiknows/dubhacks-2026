{
  "name": "dubhacks-2026",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,server,client -c magenta,blue,green \"npm run api\" \"npm run dev -w server\" \"npm run dev -w client\"",
    "api": "node scripts/run-api.mjs",
    "api:setup": "node scripts/setup-api.mjs",
    "build": "npm run build -w client",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
