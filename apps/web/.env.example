# Server only. Never expose these in the browser.
FIRMS_MAP_KEY=
XAI_API_KEY=
XAI_VOICE_MODEL=grok-voice-latest
# Use private-site only behind Sites owner-private authentication.
VOICE_ACCESS_MODE=
# Otherwise set a private demo access code for Voice endpoints.
VOICE_ACCESS_TOKEN=

# Public basemap style. The default is the OpenFreeMap Liberty style.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# OrbiCart evidence. NASA Earthdata Login token for SRTM elevation, and for GPM IMERG once the
# account approves the "NASA GESDISC DATA ARCHIVE" application. Server only.
EARTHDATA_TOKEN=
