PORT=3001
# Internal Next server. Open the complete application through Express on port 3001.
ORBICART_WEB_URL=http://127.0.0.1:3000
# Only behind a host that authenticates and overwrites oai-authenticated-* headers.
# Public/local servers use the source Voice demo access token instead.
TRUST_PRIVATE_SITE_HEADERS=false
# Use the same Python origin for the gateway, marketplace search and voice.
CONJURE_API_URL=http://127.0.0.1:8000
CONJURE_API_TIMEOUT_MS=125000
PYTHON_API_URL=http://127.0.0.1:8000
# Marketplace names the Python fetch bot should query (comma-separated).
MARKETPLACES=amazon,ebay,walmart

# --- Stripe Checkout: TEST keys only (sk_test_...). The server refuses to start with a live key. ---
# Empty = mock checkout: items are marked purchased without any payment, and responses say mock: true.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3001/api/stripe/webhook` (whsec_...). Optional:
# the success redirect also confirms payment, the webhook covers tabs closed before redirect.
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends the shopper back after paying or cancelling.
CLIENT_URL=http://localhost:3001
# Mock checkout also sends Fake Store / DummyJSON listings to those sites' sandbox carts.
# off = record the demo order locally only (no network).
MOCK_ORDER_SANDBOX=on

# ---- Store APIs (services/stores/) -------------------------------------
# Leave a key blank to skip that store. GET /api/stores shows what is live.
# UPCitemdb, Open Food Facts + Open Prices, DummyJSON and Fake Store need no key.

# Best Buy: free key, https://developer.bestbuy.com
BESTBUY_API_KEY=

# Kroger: free app (client credentials), https://developer.kroger.com
# Prices and stock need a store id (look one up with the Locations API).
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_LOCATION_ID=

# Etsy Open API v3: the x-api-key value Etsy gives your app
ETSY_API_KEY=

# eBay Browse API: production keyset (EBAY_ENV=sandbox for sandbox keys)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_ENV=production

# Individual stores, comma-separated domains. Shopify works tokenless on a
# store's primary domain; add "|token" for a Storefront access token.
WOOCOMMERCE_STORES=
SHOPIFY_STORES=www.allbirds.com

# UPCitemdb: blank uses the free trial (100 requests/day)
UPCITEMDB_USER_KEY=

# Open Icecat: free account username; fills in descriptions/images by barcode
ICECAT_USERNAME=

# STORES_LIVE=false skips external store APIs; Python marketplace search remains available.
STORES_LIVE=true
# Comma list of provider ids to skip, e.g. upcitemdb,etsy
STORES_DISABLED=
# fallback: sample APIs only when no real store matched | always | off
# Use always for the fake-purchase demo, so mock orders reach the DummyJSON / Fake Store sandboxes.
STORES_SAMPLE_DATA=fallback
STORES_LIMIT=4
STORES_TIMEOUT_MS=6000

# ---- Google sign-in + Calendar (onboarding) ----------------------------
# OAuth client of type "Web application" from Google Cloud Console.
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
# Without these, onboarding skips the Google step and still runs the quiz.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where users open the app. The callback redirects back here.
APP_ORIGIN=http://localhost:3001
# Encrypts saved Google tokens. Generated into server/data/secret.key when unset;
# set it explicitly when deploying, and keep it the same across restarts.
SESSION_SECRET=
# Where accounts are saved (default server/data/accounts.json)
ACCOUNTS_FILE=
